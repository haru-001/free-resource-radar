{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index?__path=$1" }
  ],
  "crons": [
    { "path": "/api/vercel-cron", "schedule": "0 1 * * *" }
  ]
}
